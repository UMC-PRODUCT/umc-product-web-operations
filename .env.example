# =============================================================================
# 로컬 개발(.env)에서만 쓰는 설정입니다.
# 배포(dev.admin / admin)는 호스트명으로 API·인증 앱 주소를 자동 결정하므로
# 아래 변수가 없어도 동작합니다. 이 파일을 복사해 `.env`를 만든 뒤 필요만 켜세요.
# =============================================================================

# --- Vite 개발 서버 API 프록시 -----------------------------------------------
# 브라우저가 `/api/...` 로 요청하면, Vite가 이 주소로 대신 전달합니다.
# (로컬 SSO 설정의 apiBaseUrl이 빈 문자열이라 상대 경로 `/api`를 쓰기 때문입니다.)
#
# 값을 안 쓰면 기본 대상은 개발 API입니다.
#   https://api-dev.university.neordinary.com
#
# 로컬에서 백엔드 서버를 직접 띄웠다면 그 주소로 바꿉니다.
#   VITE_DEV_API_PROXY_TARGET=http://localhost:8080
#
# 바꾼 뒤에는 `pnpm dev`를 다시 시작해야 프록시에 반영됩니다.
# VITE_DEV_API_PROXY_TARGET=https://api-dev.university.neordinary.com
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# --- 로컬 인증 앱(SSO UI) 주소 ------------------------------------------------
# `loginMode`가 auth-app 일 때, 로그인·로그아웃 화면이 있는 인증 앱 URL입니다.
# localhost에서만 의미를 가지며, 배포 환경에서는 코드의 stage 표를 씁니다.
#   - local  → (이 변수 또는 기본값)
#   - dev    → https://dev.auth.university.neordinary.com
#   - prod   → https://auth.university.neordinary.com
#
# 인증 앱을 로컬 5174 포트에서 돌릴 때 기본값이 바로 그 주소입니다.
# 포트를 바꿨다면 여기만 맞추면 됩니다.
# VITE_AUTH_APP_URL=http://localhost:5174

# --- 로컬 로그인 방식 --------------------------------------------------------
# localhost 전용입니다. 배포(dev/prod admin)에서는 항상 auth-app 입니다.
#
#   direct   (기본값)
#     - 인증 앱 없이, 이 백오피스 `/login`에 이메일·비밀번호 개발 폼을 띄웁니다.
#     - 로컬 API(또는 프록시)로 바로 로그인한 뒤 SSO authorize를 이어서 탑니다.
#
#   auth-app
#     - `/login`에 들어오면 곧바로 VITE_AUTH_APP_URL(인증 앱)로 이동합니다.
#     - 실제 배포와 같은 흐름을 로컬에서 검증할 때 사용합니다.
#     - 인증 앱이 http://localhost:5174 등에서 떠 있어야 합니다.
#
# VITE_SSO_LOGIN_MODE=direct
# VITE_SSO_LOGIN_MODE=auth-app
