# 로컬 브라우저의 API base. 비우면 같은 origin의 /api 로 요청하고, dev 서버가 프록시한다.
VITE_API_BASE_URL=

# `pnpm dev` 프록시 대상. TODO: SSO alpha api 호스트는 미확정이다.
# 기존 개발 프록시 기본값은 vite.config.ts의 DEFAULT_DEV_API_PROXY_TARGET 이다.
# VITE_DEV_API_PROXY_TARGET=https://api-dev.university.neordinary.com
# VITE_DEV_API_PROXY_TARGET=http://localhost:8080

# dev.admin origin 빌드에서 쓰는 alpha api. TODO: 호스트 미확정. 비어 있으면 로그인을 시작하지 않는다.
# VITE_ALPHA_API_BASE_URL=

# 로컬 기본값은 http://localhost:5174. dev.admin origin에서는 필수다.
# TODO: 개발 배포 인증 앱 호스트는 미확정이다.
# VITE_AUTH_APP_URL=http://localhost:5174

# localhost 전용. direct | auth-app. 기본값은 direct.
# VITE_SSO_LOGIN_MODE=direct
